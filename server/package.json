{
  "name": "drawzone-server",
  "version": "1.0.0",
  "description": "DrawZone backend: Express + Socket.IO real-time drawing and guessing game server",
  "main": "server.js",
  "private": true,
  "engines": { "node": ">=18" },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test",
    "test:unit": "node --test tests/validation.test.js tests/scoring.test.js tests/rooms.test.js tests/game.test.js",
    "test:integration": "node --test tests/integration.test.js"
  },
  "dependencies": {
    "express": "^4.21.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.1"
  }
}
