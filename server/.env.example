# Server settings (optional). Defaults work without any .env file.
# Node does not read this file automatically. In PowerShell set values like:
#   $env:PORT = "3001"
#   $env:CLIENT_ORIGINS = "http://localhost:5173,http://192.168.1.10:5173"
PORT=3001
# Comma separated list of allowed browser origins. If empty, localhost and
# private LAN addresses (192.168.x.x, 10.x.x.x, 172.16-31.x.x) are allowed (development only).
CLIENT_ORIGINS=
